# ── MongoDB ────────────────────────────────────────────────
# Atlas: https://cloud.mongodb.com → Connect → Drivers → copy string
# Local:  mongodb://127.0.0.1:27017/ds-photography
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ds-photography?retryWrites=true&w=majority"

# Only `npm run migrate-cluster` reads this — the cluster to copy everything to
# when moving house. Leave it blank the rest of the time.
# TARGET_MONGODB_URI=""

# ── Admin session ──────────────────────────────────────────
# Generate a strong secret:  openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# ── Cloudinary ─────────────────────────────────────────────
# Dashboard → Settings → API Keys
# The cloud name and key are used by the upload window in the browser and by the
# server alike, so they're written once, here. They're public by design: an
# upload is only accepted with a signature from our server, made with the secret.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_API_KEY=""
# The secret stays on the server: never give it a NEXT_PUBLIC_ name.
CLOUDINARY_API_SECRET=""

# ── Seed admin (used once by `npm run seed`) ───────────────
SEED_ADMIN_EMAIL="admin@dsphotography.com"
SEED_ADMIN_PASSWORD="change-this-password"
SEED_ADMIN_NAME="Administrator"

